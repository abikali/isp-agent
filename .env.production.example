# ============================================================
# LibanCom Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# For VitoDeploy: paste these into Site > Application > .env
# Generate secrets with: openssl rand -base64 32
# ============================================================

# ========== Core ==========
NODE_ENV=production
PORT=3000
TZ=Asia/Beirut

# ========== Database ==========
# Full connection string (used by Prisma and the app)
DATABASE_URL="postgresql://libancom:PASSWORD@localhost:5432/libancom"

# Docker Compose only (ignored in bare-metal deploys):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=libancom

# ========== Redis ==========
REDIS_URL="redis://localhost:6379"

# ========== Authentication ==========
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match your public URL (used by Better Auth for callbacks)
BETTER_AUTH_URL="https://libancom.abiroot.dev"

# ========== URLs ==========
# VITE_* vars are baked into the client bundle at build time
VITE_SITE_URL="https://libancom.abiroot.dev"
SITE_URL="https://libancom.abiroot.dev"

# ========== AI ==========
# Encryption key for storing AI channel API tokens in DB
# Generate with: openssl rand -hex 32 (must be 64 hex chars)
AI_CHANNEL_ENCRYPTION_KEY=

# LLM API keys are set per agent in the app (AI agent → Model), encrypted
# with AI_CHANNEL_ENCRYPTION_KEY. There is no server-wide key.

# ========== Webhooks ==========
# Token signing secret. Generate with: openssl rand -base64 32
WEBHOOK_SECRET=

# ========== Storage (Cloudflare R2 / AWS S3) ==========
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
AVATARS_BUCKET_NAME=avatars
# Optional: Public URL for R2 (if using public bucket)
S3_PUBLIC_URL=

# ========== Email ==========
MAIL_FROM=noreply@libancom.abiroot.dev
# Resend API key for transactional emails
RESEND_API_KEY=

# ========== Social Auth (optional) ==========
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ========== Payments (Stripe, optional) ==========
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========== Price IDs (optional) ==========
PRICE_ID_PRO_MONTHLY=
PRICE_ID_PRO_YEARLY=
PRICE_ID_LIFETIME=

# ========== Error Tracking (optional) ==========
SENTRY_DSN=
VITE_SENTRY_DSN=

# ========== Integrations (Nango, optional) ==========
NANGO_SECRET_KEY=
VITE_NANGO_PUBLIC_KEY=
# Self-hosted Nango URL (leave empty for Nango Cloud)
NANGO_HOST=
VITE_NANGO_HOST=
WPBOX_TOKEN=
# Referral free-month WhatsApp on payment approval (template
# referral_free_month). Leave off until Salti approves the template.
WHATSAPP_REFERRAL_REWARD_ENABLED=false

# ========== Telegram ISP bot ONU lookup ==========
# Diagnose "ONU" section + AI diagnose tool. Must equal the bot's ONU_API_KEY.
TG_ISP_BOT_URL=https://tg-isp.abiroot.dev
TG_ISP_ONU_API_KEY=
# Bot follow-up outreach on the official number (install check, day after a
# stop). Nothing is sent while a template name is empty. Set each one once
# Meta approves the template in Salti.
SALTI_TEMPLATE_INSTALL_SATISFACTION=
SALTI_TEMPLATE_SERVICE_STOP_REASON=
# Secret path segment of the inbound webhook set in Salti → WebHooks
# ("Whatsapp received data will be resend to"):
#   https://<host>/api/webhooks/salti/<SALTI_WEBHOOK_SECRET>
SALTI_WEBHOOK_SECRET=
# Optional: only accept forwarded messages for this Meta phone_number_id.
SALTI_PHONE_NUMBER_ID=
# Support-bot (WaSender) number for wa.me deep links in follow-up replies.
SUPPORT_BOT_WHATSAPP_NUMBER=
