generator client {
  provider        = "prisma-client"
  output          = "./generated"
  engineType      = "client"
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  expiresAt             DateTime?
  password              String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@map("account")
}

model AccountLockout {
  id             String    @id @default(cuid())
  userId         String    @unique
  lockedAt       DateTime  @default(now())
  unlocksAt      DateTime
  failedAttempts Int       @default(0)
  reason         String?
  unlockedAt     DateTime?
  unlockedBy     String?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([unlocksAt])
  @@map("account_lockout")
}

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  keyHash        String       @unique
  keyPrefix      String
  organizationId String
  createdById    String
  permissions    String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([keyHash])
  @@index([organizationId])
  @@map("api_key")
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  resourceType   String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([organizationId])
  @@index([resourceType])
  @@index([userId])
  @@map("audit_log")
}

model BulkOperation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  type           String // import_csv, duplicate_template, bulk_edit, bulk_delete, bulk_publish, bulk_export, bulk_duplicate, bulk_assign
  status         String       @default("pending") // pending, processing, completed, failed, cancelled
  totalItems     Int
  processedItems Int          @default(0)
  successCount   Int          @default(0)
  errorCount     Int          @default(0)
  errors         Json?
  input          Json?
  result         Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("bulk_operation")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  percentage  Int      @default(100)
  targetUsers String[] @default([])
  targetOrgs  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@map("feature_flag")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@index([expiresAt])
  @@map("invitation")
}

model KnownDevice {
  id                String   @id @default(cuid())
  userId            String
  deviceFingerprint String
  deviceName        String?
  userAgent         String?
  ipAddress         String?
  lastSeenAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("known_device")
}

model LoginAttempt {
  id            String   @id @default(cuid())
  userId        String?
  email         String
  ipAddress     String?
  userAgent     String?
  success       Boolean  @default(false)
  failureReason String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
  @@index([ipAddress])
  @@index([userId])
  @@map("login_attempt")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("member")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  category  String?  // "leads" | "team" | "analytics" | "security"
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, read])
  @@index([userId, category])
  @@map("notification")
}

model NotificationPreference {
  id             String  @id @default(cuid())
  userId         String  @unique

  // Per-category in-app toggles
  leadsInApp     Boolean @default(true)
  teamInApp      Boolean @default(true)
  analyticsInApp Boolean @default(true)
  securityInApp  Boolean @default(true)

  // Per-category email toggles
  leadsEmail     Boolean @default(true)
  teamEmail      Boolean @default(true)
  analyticsEmail Boolean @default(false)
  securityEmail  Boolean @default(true)

  // Monitoring
  monitoringInApp Boolean @default(true)
  monitoringEmail Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preference")
}

// Per-user preferences for the redesigned dashboard (density, sidebar state,
// pinned shortcuts, recent items cache, etc.). Stored as JSON values keyed by
// preference name so we can add new prefs without migrations.
model UserPref {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_pref")
}

// Server-persisted saved views for list pages (customers, tasks, payments, etc.).
// Stores filters / sort / columns / density. `pinned` adds the view as a quick
// shortcut in the sidebar.
model SavedView {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  resource       String
  name           String
  config         Json
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, resource, name])
  @@index([userId, organizationId, resource])
  @@index([organizationId])
  @@map("saved_view")
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String?            @unique
  logo                 String?
  createdAt            DateTime
  metadata             Json?
  paymentsCustomerId   String?
  aiDefaultPersona     String?            @db.Text
  aiDefaultGreeting    String?
  aiProfileLimit       Int?               // Max credits per profile per month (null = no limit)
  aiAllowedModels      String[]           @default([]) // LLM models whitelisted by org admin
  aiAgents             AiAgent[]
  aiCapturedLeads      AiCapturedLead[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  bulkOperations       BulkOperation[]
  integrationConnections IntegrationConnection[]
  invitations          Invitation[]
  members              Member[]
  roles                OrganizationRole[]
  purchases            Purchase[]
  usageQuotas          UsageQuota[]
  watchers             Watcher[]
  webhooks             Webhook[]
  customers            Customer[]
  customerInvoices     CustomerInvoice[]
  accessPoints         AccessPoint[]
  ispNasServers        IspNas[]
  ispRouters           IspRouter[]
  ispDealers           IspDealer[]
  ispDealerAccounts    IspDealerAccount[]
  iRadiusSyncOps       IRadiusSyncOperation[]
  iRadiusPushOps       IRadiusPushOperation[]
  employees            Employee[]
  servicePlans         ServicePlan[]
  stations             Station[]
  bases                Base[]
  tasks                Task[]
  billingMonths        BillingMonth[]
  payments             Payment[]
  cashCollections      CashCollection[]
  expenses             Expense[]
  stockItems           StockItem[]
  stockLogs            StockLog[]
  installations        Installation[]
  followups            Followup[]
  uninstalledItems     UninstalledItem[]
  customerSetupRequests CustomerSetupRequest[]
  stockRefundRequests  StockRefundRequest[]
  billingSyncOps           BillingSyncOperation[]
  noteCategories           NoteCategory[]
  syncConflicts            SyncConflict[]
  saltiIntegration         SaltiIntegration?
  marketingBroadcasts      MarketingBroadcast[]
  savedViews               SavedView[]

  // Dealer scope for queries through `getDealerScopeFilter` and friends.
  // When null, scoped queries match only orphan rows (`dealerId IS NULL`).
  activeDealerId String?    @unique
  activeDealer   IspDealer? @relation("ActiveDealer", fields: [activeDealerId], references: [id], onDelete: SetNull)

  // When true, every iRadius integration surface is disabled for this org:
  // mirror writes skip the remote call, sync workers refuse to run, push
  // workers bail out. Used for orgs whose dealer is "local-only" — i.e.
  // their customers should never flow to/from the legacy iRadius system.
  iradiusDisabled Boolean @default(false)

  @@map("organization")
}

model OrganizationRole {
  id             String       @id @default(cuid())
  organizationId String
  role           String
  permission     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@map("organization_role")
}

model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey")
}

model Purchase {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  type           PurchaseType
  customerId     String
  subscriptionId String?       @unique
  productId      String
  status         String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([customerId])
  @@map("purchase")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  impersonatedBy       String?
  activeOrganizationId String?
  token                String   @unique
  createdAt            DateTime
  updatedAt            DateTime
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model TwoFactor {
  id          String @id @default(cuid())
  secret      String
  backupCodes String
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor")
}

model UsageQuota {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  quotaType      String
  used           Int           @default(0)
  limit          Int
  resetAt        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, quotaType])
  @@unique([userId, quotaType])
  @@index([organizationId])
  @@index([quotaType])
  @@index([userId])
  @@map("usage_quota")
}

model User {
  id                  String          @id @default(cuid())
  name                String
  email               String          @unique
  emailVerified       Boolean
  image               String?
  createdAt           DateTime
  updatedAt           DateTime
  username            String?         @unique
  role                String?
  banned              Boolean?
  banReason           String?
  banExpires          DateTime?
  onboardingComplete  Boolean         @default(false)
  paymentsCustomerId  String?
  locale              String?
  displayUsername     String?
  twoFactorEnabled    Boolean?
  deletionScheduledAt DateTime?
  deletionReason      String?
  accounts            Account[]
  accountLockout      AccountLockout?
  aiAgentsCreated     AiAgent[]      @relation("aiAgentCreator")
  apiKeys             ApiKey[]
  auditLogs           AuditLog[]
  bulkOperations      BulkOperation[]
  integrationConnections IntegrationConnection[]
  invitations         Invitation[]
  knownDevices        KnownDevice[]
  loginAttempts       LoginAttempt[]
  members             Member[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  passkeys                Passkey[]
  purchases           Purchase[]
  sessions            Session[]
  twoFactors          TwoFactor[]
  usageQuotas         UsageQuota[]
  watchersCreated     Watcher[]          @relation("watcherCreator")
  tasksCreated        Task[]             @relation("taskCreator")
  employee            Employee?          @relation("EmployeeUser")
  dealer              IspDealer?         @relation("DealerUser")
  cashCollectionsReceived CashCollection[] @relation("CashReceiver")
  expensesApproved    Expense[]          @relation("ExpenseApprover")
  stockLogsPerformed  StockLog[]         @relation("StockLogPerformer")
  installationsApproved Installation[]   @relation("InstallationApprover")
  uninstalledItemsReviewed UninstalledItem[] @relation("UninstalledItemReviewer")
  setupRequestsReviewed CustomerSetupRequest[] @relation("SetupRequestReviewer")
  stockRefundRequestsReviewed StockRefundRequest[] @relation("StockRefundReviewer")
  resolvedConflicts     SyncConflict[]   @relation("ConflictResolver")
  pushSubscriptions     PushSubscription[]
  userPrefs             UserPref[]
  savedViews            SavedView[]

  @@map("user")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscription")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Webhook {
  id             String            @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[]
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  webhookId   String
  event       String
  payload     Json
  statusCode  Int?
  response    String?   @db.Text
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())
  webhook     Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([webhookId])
  @@map("webhook_delivery")
}

// ============================================================================
// INTEGRATION MODELS (Third-party integrations via Nango)
// ============================================================================

model IntegrationConnection {
  id                String   @id @default(cuid())
  organizationId    String
  createdById       String

  // Nango identifiers
  providerConfigKey String   // "hubspot", "salesforce", "slack"
  connectionId      String   // Nango's unique connection ID

  // Display
  name              String?  // User-friendly name
  providerName      String   // "HubSpot", "Salesforce"

  // Sync configuration (user-configurable)
  syncMode          String   @default("manual") // "manual" | "auto"
  autoSyncEvents    String[] @default([])       // ["contact.created", "contact.updated"]

  // Status
  status            String   @default("connected") // connected, error, disconnected
  lastSyncAt        DateTime?
  lastError         String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  syncOperations    ContactSyncOperation[]

  @@unique([organizationId, providerConfigKey])
  @@index([organizationId])
  @@index([createdById])
  @@index([status])
  @@map("integration_connection")
}

model ContactSyncOperation {
  id            String   @id @default(cuid())
  connectionId  String

  // Operation details
  type          String   // "push_single", "push_bulk", "sync_all"
  status        String   @default("pending") // pending, processing, completed, failed
  trigger       String?  // "manual", "contact.created", "contact.updated"

  // Counts
  totalContacts Int
  successCount  Int      @default(0)
  errorCount    Int      @default(0)

  // Results
  errors        Json?    // Array of {contactId, error} objects
  result        Json?    // Provider response data

  // Timing
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([status])
  @@index([createdAt])
  @@map("contact_sync_operation")
}

// ============================================================================
// AI AGENT MODELS (Chat agents for WhatsApp/Telegram)
// ============================================================================

model AiAgent {
  id               String           @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  systemPrompt     String           @db.Text
  greetingMessage  String?
  model            String           @default("gpt-4o-mini")
  knowledgeBase    String?          @db.Text
  enabled             Boolean          @default(true)
  maintenanceMode     Boolean          @default(false)
  maintenanceMessage  String?          @db.Text
  maxHistoryLength Int              @default(20)
  temperature      Float            @default(0)
  enabledTools     String[]         @default([])
  promptSections   Json             @default("[]")
  servicePlansEnabled        Boolean       @default(false)
  servicePlanIds             String[]      @default([])
  contextGapThresholdMinutes Int           @default(240)
  humanTakeoverHours Float?          @map("human_takeover_hours")
  webChatEnabled   Boolean          @default(false)
  webChatToken     String?          @unique
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                  @relation("aiAgentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  channels       AiAgentChannel[]
  conversations  AiConversation[]
  toolConfigs    AiAgentToolConfig[]
  capturedLeads  AiCapturedLead[]
  maintenanceWindows AiMaintenanceWindow[]

  @@index([organizationId])
  @@map("ai_agent")
}

model AiAgentChannel {
  id                String    @id @default(cuid())
  agentId           String
  provider          String    // "whatsapp" | "telegram"
  name              String
  webhookToken      String    @unique
  webhookSecret     String?   // For Telegram secret_token verification
  encryptedApiToken String    @db.Text
  providerMetadata  Json?
  enabled           Boolean   @default(true)
  lastActivityAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agent         AiAgent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations AiConversation[]

  @@index([agentId])
  @@map("ai_agent_channel")
}

model AiConversation {
  id                 String    @id @default(cuid())
  agentId            String
  channelId          String?
  externalChatId     String
  contactName        String?
  contactId          String?
  status             String    @default("active")
  pinned             Boolean   @default(false)
  messageCount       Int       @default(0)
  lastMessageAt      DateTime?
  verifiedCustomerId String?
  pinAttempts        Int       @default(0)
  pinLockedUntil     DateTime?
  humanTakeoverAt    DateTime? @map("human_takeover_at")
  unknownEscalatedAt DateTime? @map("unknown_escalated_at")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  agent            AiAgent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel          AiAgentChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  verifiedCustomer Customer?        @relation(fields: [verifiedCustomerId], references: [id], onDelete: SetNull)
  messages         AiMessage[]
  capturedLeads    AiCapturedLead[]
  tasks            Task[]

  @@index([channelId, externalChatId, status])
  @@index([agentId])
  @@index([agentId, externalChatId])
  @@index([channelId])
  @@index([lastMessageAt])
  @@map("ai_conversation")
}

model AiMessage {
  id                 String    @id @default(cuid())
  conversationId     String
  role               String    // "user" | "assistant" | "admin"
  content            String    @db.Text
  externalMsgId      String?
  tokenCount         Int?
  latencyMs          Int?
  error              String?
  toolCalls          Json?     // Legacy: Array of {toolName, args, result}. New writes use `parts`.
  parts              Json?     // Canonical UIMessage parts array (text, tool-call, tool-result, reasoning). Source of truth for new messages.
  inputTokens        Int?
  outputTokens       Int?
  cacheReadTokens    Int?
  cacheWriteTokens   Int?
  replyToId          String?
  deliveryStatus     String?   // "sent" | "delivered" | "read"
  editedAt           DateTime?
  deletedAt          DateTime?
  attachmentType     String?   // "image" | "video" | "audio" | "document" | "location" | "sticker"
  attachmentUrl      String?
  attachmentFilename String?
  attachmentMimeType String?
  attachmentSize     Int?
  attachmentMeta     Json?     // { width, height, duration, lat, lng, etc. }
  createdAt          DateTime  @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      AiMessage?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      AiMessage[]    @relation("MessageReplies")
  reactions    AiMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([externalMsgId])
  @@map("ai_message")
}

model AiMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  emoji     String
  userId    String?
  contactId String?
  createdAt DateTime @default(now())

  message AiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@unique([messageId, contactId])
  @@index([messageId])
  @@map("ai_message_reaction")
}

model AiAgentToolConfig {
  id            String   @id @default(cuid())
  agentId       String
  toolId        String
  config        Json
  promptSection String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolId])
  @@index([agentId])
  @@map("ai_agent_tool_config")
}

model AiMaintenanceWindow {
  id        String   @id @default(cuid())
  agentId   String
  startsAt  DateTime
  endsAt    DateTime
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, startsAt, endsAt])
  @@map("ai_maintenance_window")
}

model AiCapturedLead {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  conversationId String
  externalChatId String
  name           String
  email          String?
  phone          String?
  company        String?
  title          String?
  notes          String?  @db.Text
  source         String   @default("ai_agent")
  exportedToCrm  Boolean  @default(false)
  crmExportId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AiAgent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([agentId])
  @@index([conversationId])
  @@map("ai_captured_lead")
}

// ============================================================================
// WATCHER MODELS (Infrastructure monitoring)
// ============================================================================

model Watcher {
  id               String    @id @default(cuid())
  organizationId   String
  createdById      String
  name             String
  type             String    // "ping" | "http" | "port" | "dns"
  target           String    // hostname, URL, or IP
  config           Json?     // type-specific: { port, expectedStatus, method, recordType, etc. }
  intervalSeconds  Int       // 60, 300, 900, 1800, 3600
  enabled          Boolean   @default(true)
  status           String    @default("unknown") // "up" | "down" | "unknown"
  lastCheckedAt    DateTime?
  lastStatusChange DateTime?
  nextRunAt        DateTime  @default(now())
  notifiedDownAt     DateTime? // throttle: null = not notified yet for current incident
  notificationConfig Json?
  lastReminderAt     DateTime?
  consecutiveFails Int       @default(0)
  consecutiveOk    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User               @relation("watcherCreator", fields: [createdById], references: [id], onDelete: Cascade)
  executions   WatcherExecution[]

  @@index([organizationId])
  @@index([enabled, nextRunAt])
  @@map("watcher")
}

model WatcherExecution {
  id        String   @id @default(cuid())
  watcherId String
  status    String   // "up" | "down"
  latencyMs Int?
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  watcher Watcher @relation(fields: [watcherId], references: [id], onDelete: Cascade)

  @@index([watcherId, createdAt])
  @@map("watcher_execution")
}

enum PurchaseType {
  SUBSCRIPTION
  ONE_TIME
}

// ============================================================================
// CUSTOMER MANAGEMENT MODELS (ISP subscriber management)
// ============================================================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum ConnectionType {
  FIBER
  WIRELESS
  DSL
  CABLE
  ETHERNET
}

enum StationStatus {
  ACTIVE
  MAINTENANCE
  OFFLINE
}

model ServicePlan {
  id              String   @id @default(cuid())
  organizationId  String
  externalId      String?
  name            String
  description     String?
  downloadSpeed   Int // Mbps
  uploadSpeed     Int // Mbps
  monthlyPrice    Float
  validityPeriod  Int?     // Days the plan is valid
  monthlyQuota    Int?     // Combined monthly quota (GB)
  dailyQuotaUp    Int?     // Separate daily upload limit
  dailyQuotaDown  Int?     // Separate daily download limit
  ipPoolName      String?  // RADIUS IP pool name
  maxUsers        Int?     // Simultaneous connections allowed
  visible          Boolean  @default(true) // Shown on customer-facing UI
  commission       Float    @default(0)
  parentCommission Float    @default(0)
  dealerExternalId String?  // iRadius DealerId (legacy, use dealerId)
  dealerId         String?
  archived         Boolean  @default(false)
  // iRadius AccountType fields
  rate                       Float?   // Wholesale rate (AccountType.Rate)
  sellingPrice               Float?   // Dealer selling price (AccountType.SellingPrice)
  autoBindAccToMac           Boolean  @default(false)
  refundable                 Boolean  @default(false)
  refundableByGb             Boolean  @default(false)
  canChangeMac               Boolean  @default(false)
  canChangeUserName          Boolean  @default(false)
  immediateRecharge          Boolean  @default(false)
  preventBeforeRecharge      Boolean  @default(false)
  totalSession               Int?
  totalSessionPeriodTypeId   Int?
  validityPeriodTypeId       Int?
  separateMaxMonthlyUp       Int?
  separateMaxMonthlyDown     Int?
  monthlyPoolAfterMax        String?
  ulDlForAutoFallBack        Boolean  @default(false)
  unlimitedTimeTo            String?
  unlimitedTimeFrom          String?
  newIpPoolAfterMax          String?
  combinedMaxUpAndDown       Int?
  // iRadius "UP TO X" plans carry no explicit quota column; their cap lives in
  // the auto-fallback step tables (AccountType{Daily,Monthly}AutoFallBack.AboveMB
  // — the data volume in MB after which the subscriber is throttled). We mirror
  // the lowest step here so the usage cell can show the real cap instead of a
  // default. See AboveMB note in iradius-sync.worker.ts.
  dailyFallbackMb            Int?
  monthlyFallbackMb          Int?
  resetCounterTime           String?
  expiryAccountPool          String?
  ulDlMonthlyForAutoFallBack Boolean  @default(false)
  disablePoolName            String?
  proceraId                  Int?
  expiryProceraId            Int?
  accountTypeCategory        Int?
  adminId                    Int?
  canExcludeQuotaByIpAddress Boolean  @default(false)
  fupResetPrice              Float?
  addressListId              Int?
  defaultAddressListIds      Int?
  queueTreeMode              Boolean  @default(false)
  iRadiusNasId               Int?     // AccountType.NasId (iRadius FK, not our FK)
  lastSyncedAt    DateTime?
  // Soft-delete marker set by iRadius sync cleanup when the corresponding
  // AccountType row is no longer present in iRadius. Cleared on restore.
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealer       IspDealer?   @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  customers    Customer[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([dealerId])
  @@map("service_plan")
}

model Station {
  id             String        @id @default(cuid())
  organizationId String
  externalId     String?
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  status         StationStatus @default(ACTIVE)
  capacity       Int?
  notes          String?
  host           String?       // IP for API access
  apiPort        Int?          // MikroTik API port
  sshPort        Int?          // SSH port
  vlanId         Int?          // VLAN assignment
  version        String?       // Firmware version
  uptime         String?       // Last known uptime
  sshUsername    String?       // SSH login username
  sshPassword   String?       // SSH login password
  apUsername     String?       // Access point API username
  apPassword     String?       // Access point API password
  apApiPort      Int?          // Access point API port
  apSshPort      Int?          // Access point SSH port
  // iRadius monitoring fields
  boardName      String?
  cpuLoad        String?
  voltage        String?
  online         Boolean       @default(false)
  scanStatus     Boolean       @default(false)
