  customers      Customer[]
  employees      Employee[]
  servicePlans   ServicePlan[]
  bases          Base[]
  dealerAccounts         IspDealerAccount[]
  activeForOrganization  Organization?       @relation("ActiveDealer")

  @@unique([email])
  @@index([organizationId])
  @@index([parentDealerId])
  @@index([deletedAt])
  @@map("isp_dealer")
}

