model IRadiusSyncOperation {
  id                      String    @id @default(cuid())
  organizationId          String?
  status                  String    @default("pending")
  phase                   String?
  totalPlans              Int       @default(0)
  processedPlans          Int       @default(0)
  totalStations           Int       @default(0)
  processedStations       Int       @default(0)
  totalAccessPoints       Int       @default(0)
  processedAccessPoints   Int       @default(0)
  totalNas                Int       @default(0)
  processedNas            Int       @default(0)
  totalRouters            Int       @default(0)
  processedRouters        Int       @default(0)
  totalDealers            Int       @default(0)
  processedDealers        Int       @default(0)
  totalDealerAccounts     Int       @default(0)
  processedDealerAccounts Int       @default(0)
  totalEmployees          Int       @default(0)
  processedEmployees      Int       @default(0)
  totalCustomers          Int       @default(0)
  processedCustomers      Int       @default(0)
  // Soft-deletes and restores recorded in this run (sum across all phases).
  // Detailed per-entity counts live in the `result` JSON blob.
  removedRecords          Int       @default(0)
  restoredRecords         Int       @default(0)
  result                  Json?
  totalConflicts          Int       @default(0)
  resolvedConflicts       Int       @default(0)
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conflicts    SyncConflict[]

  @@index([organizationId])
  @@map("iradius_sync_operation")
}

model IRadiusPushOperation {
  id                  String    @id @default(cuid())
  organizationId      String
  status              String    @default("pending")
  phase               String?
  totalCustomers      Int       @default(0)
  processedCustomers  Int       @default(0)
  pushedCustomers     Int       @default(0)
  skippedCustomers    Int       @default(0)
  failedCustomers     Int       @default(0)
  result              Json?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("iradius_push_operation")
}

model SyncConflict {
  id              String    @id @default(cuid())
  organizationId  String
  syncOperationId String
  customerId      String
  externalId      String    // iRadius User.Id as string
  // JSON: Record<fieldName, { local: string | null, remote: string | null, resolution: "keep_local" | "keep_remote" | null }>
  fields          Json
  status          String    @default("pending") // "pending" | "resolved"
  resolvedAt      DateTime?
  resolvedById    String?
  createdAt       DateTime  @default(now())

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  syncOperation  IRadiusSyncOperation @relation(fields: [syncOperationId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  resolvedBy     User?                @relation("ConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([syncOperationId, customerId])
  @@index([organizationId, status])
  @@index([syncOperationId])
  @@index([customerId])
  @@map("sync_conflict")
}

model BillingSyncOperation {
  id                     String    @id @default(cuid())
  organizationId         String
  status                 String    @default("pending") // pending | in_progress | completed | failed
  phase                  String?
  totalCustomers         Int       @default(0)
  processedCustomers     Int       @default(0)
  totalPayments          Int       @default(0)
  processedPayments      Int       @default(0)
  totalCollections       Int       @default(0)
  processedCollections   Int       @default(0)
  totalExpenses          Int       @default(0)
  processedExpenses      Int       @default(0)
  totalStockItems        Int       @default(0)
  processedStockItems    Int       @default(0)
  totalWorkerStock       Int       @default(0)
  processedWorkerStock   Int       @default(0)
  totalInstallations     Int       @default(0)
  processedInstallations Int       @default(0)
  totalReconciled        Int       @default(0)
  processedReconciled    Int       @default(0)
  result                 Json?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("billing_sync_operation")
}


// ============================================================================
// EMPLOYEE & TASK MANAGEMENT MODELS
// ============================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum EmployeeDepartment {
  TECHNICAL
  CUSTOMER_SERVICE
  BILLING
  MANAGEMENT
  FIELD_OPS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  INSTALLATION
  MAINTENANCE
  REPLACEMENT
  REPAIR
  SUPPORT
  BILLING
  GENERAL
  FOLLOW_UP
  UNINSTALL
}

enum TaskSource {
  MANUAL
  AI_ESCALATION
  LEGACY

  @@map("task_source")
}

model Employee {
  id             String             @id @default(cuid())
  organizationId String
  employeeNumber String
  name           String
  email          String?
  phone          String?
  position       String?
  department     EmployeeDepartment?
  hireDate       DateTime?
  status         EmployeeStatus     @default(ACTIVE)
  notes          String?            @db.Text
  externalId     String?
  iRadiusProfile String?
  username        String?
  preferredLayout String            @default("standard") @map("preferred_layout")
  telegramChatId  String?           @map("telegram_chat_id")
  userId          String?           @unique
  dealerId        String?
  lastSyncedAt   DateTime?
  // Soft-delete marker set by iRadius sync cleanup when the corresponding
  // User row (ProfileId IN 1,3,6,7,8) is no longer present in iRadius.
  // Hard-delete is avoided because Payment.collectorId / workerId references
  // may exist and the related User account often outlives the iRadius row.
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?                 @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  dealer                IspDealer?            @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  stations              EmployeeStation[]
  bases                 BaseEmployee[]
  taskAssignments       TaskAssignment[]
  customerCollections   Customer[]            @relation("CustomerCollector")
  customerWorkerAssignments Customer[]        @relation("CustomerWorker")
  paymentsCollected     Payment[]             @relation("PaymentCollector")
  paymentsAsWorker      Payment[]             @relation("PaymentWorker")
  cashCollections       CashCollection[]      @relation("CashCollector")
  expensesSubmitted     Expense[]             @relation("ExpenseSubmitter")
  workerStock           WorkerStock[]
  stockLogs             StockLog[]
  installationsDone     Installation[]        @relation("Installer")
  tasksCompleted        Task[]                @relation("TaskCompleter")
  setupRequests         CustomerSetupRequest[] @relation("SetupRequester")
  stockRefundRequests   StockRefundRequest[]  @relation("StockRefundRequester")

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, externalId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([dealerId])
  @@index([status])
  @@index([organizationId, name])
  @@map("employee")
}

model EmployeeStation {
  id         String   @id @default(cuid())
  employeeId String
  stationId  String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  station  Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, stationId])
  @@index([employeeId])
  @@index([stationId])
  @@map("employee_station")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  category       TaskCategory @default(GENERAL)
  source         TaskSource   @default(MANUAL)
  dueDate        DateTime?
  completedAt    DateTime?
  notes          String?      @db.Text
  createdById    String?
  customerId     String?
  stationId      String?
  baseId         String?
  conversationId String?
  followUpStatus String?        // pending | contacted | promised | resolved | escalated
  externalBillingId Int?        @map("external_billing_id")
  // Field-work completion evidence (worker portal)
  resolutionCode        String?   // canned-reply key, see packages/api/modules/tasks/lib/resolutions.ts
  resolutionNote        String?   @db.Text
  completionPhotoUrl    String?
  completedByEmployeeId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("taskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  station      Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  base         Base?            @relation(fields: [baseId], references: [id], onDelete: SetNull)
  conversation AiConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  completedByEmployee Employee? @relation("TaskCompleter", fields: [completedByEmployeeId], references: [id], onDelete: SetNull)
  assignments  TaskAssignment[]
  uninstalledItems UninstalledItem[]
  installations    Installation[]

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([customerId])
  @@index([stationId])
  @@index([baseId])
  @@index([conversationId])
  @@index([dueDate])
  @@map("task")
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  employeeId String
  assignedAt DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignment")
}

// ─── Billing Enums ─────────────────────────────────────────────────

enum PaymentStatus {
  COLLECTED
}

model NoteCategory {
  id             String       @id @default(cuid())
  organizationId String
  value          String       // Machine-readable key (e.g. "DOWNGRADE")
  label          String       // Display label (e.g. "Downgrade")
  labelAr        String?      // Arabic label (e.g. "تصغير")
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, value])
  @@index([organizationId])
  @@map("note_category")
}

enum CashCollectionType {
  HANDOFF
  EXPENSE_DEDUCTION
  STOCK_RECEIVED
  INSTALLATION_COST
  DEALER_PAYMENT
  ADMIN_TRANSFER
  NEW_USER_SETUP
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstallationStatus {
  PENDING
  APPROVED
  COMPLETED
  DENIED
}

enum SetupRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockAction {
  ADD
  REMOVE
  TRANSFER_TO_WORKER
  TRANSFER_FROM_WORKER
  ADJUST
  DELIVER
}

enum StockRefundStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Billing ───────────────────────────────────────────────────────

model BillingMonth {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  month          Int
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([organizationId, year, month])
  @@index([organizationId])
  @@map("billing_cycle")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String
  billingMonthId  String        @map("billingCycleId")
  invoiceId       String?       @unique
  collectorId     String
  accountPrice    Float
  paidAmount      Float
  discount        Float         @default(0)
  status          PaymentStatus @default(COLLECTED)
  freeAccount     Boolean       @default(false)
  stoppedAccount  Boolean       @default(false)
  workerId        String?
  noteCategory    String?
  notes           String?       @db.Text
  receiptSent     Boolean       @default(false)
  receiptSentAt   DateTime?
  activityLog     Json          @default("[]")
  reviewedAt      DateTime?
  paidAt          DateTime      @default(now())
  externalBillingId Int?        @map("external_billing_id")
  referredCustomerId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billingMonth BillingMonth @relation(fields: [billingMonthId], references: [id], onDelete: Cascade)
  invoice      CustomerInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  collector    Employee     @relation("PaymentCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  worker       Employee?    @relation("PaymentWorker", fields: [workerId], references: [id], onDelete: SetNull)
  referredCustomer Customer? @relation("PaymentReferrer", fields: [referredCustomerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, billingMonthId])
  @@index([workerId])
  @@index([customerId])
  @@index([collectorId])
  @@index([stoppedAccount])
  @@index([referredCustomerId])
  @@map("payment")
}

model CashCollection {
  id                String             @id @default(cuid())
  organizationId    String
  collectorId       String
  amount            Float
  notes             String?            @db.Text
  type              CashCollectionType @default(HANDOFF)
  expenseId         String?            @unique
  receivedById      String?
  externalBillingId Int?               @map("external_billing_id")
  collectedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collector    Employee     @relation("CashCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  receivedBy   User?        @relation("CashReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  expense      Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, collectorId])
  @@index([collectedAt])
  @@map("cash_collection")
}

model LocationRequest {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  token          String    @unique
  expiresAt      DateTime
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId])
  @@index([customerId])
  @@map("location_request")
}

model Expense {
  id                String        @id @default(cuid())
  organizationId    String
  submittedById     String
  amount            Float
  description       String        @db.Text
  category          String?       // toolkit | electricity | roof | other (free text allowed)
  receiptUrl        String?
  status            ExpenseStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  externalBillingId Int?          @map("external_billing_id")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  Employee        @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  collection   CashCollection?

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, status])
  @@index([submittedById])
  @@map("expense")
}

// ─── Inventory ─────────────────────────────────────────────────────

model StockItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  quantity       Int      @default(0)
  costPrice      Float    @default(0)
  sellPrice      Float    @default(0)
  alertThreshold Int?
  alertEnabled   Boolean  @default(false)
  // When true, this item appears in the worker uninstall task's recovered-item
  // dropdown (an admin-curated list of recoverable equipment), regardless of
  // whether the worker personally holds it in their own stock.
  showInUninstall Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workerAllocations WorkerStock[]
  logs              StockLog[]
  installations     Installation[]
  uninstalledItems  UninstalledItem[]
  refundRequests    StockRefundRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("stock_item")
}

model WorkerStock {
  id          String   @id @default(cuid())
  stockItemId String
  employeeId  String
  quantity    Int      @default(0)
  unitPrice   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, employeeId])
  @@index([stockItemId])
  @@index([employeeId])
  @@map("worker_stock")
}

// A field worker's request to return stock they hold back to the warehouse.
// PENDING → APPROVED/REJECTED. Approval moves the stock back to admin
// inventory (decrement WorkerStock, increment StockItem, write a
// TRANSFER_FROM_WORKER StockLog) — no cash-ledger entry, mirroring how stock
// delivery never touches the cash ledger either.
model StockRefundRequest {
  id             String            @id @default(cuid())
  organizationId String
  stockItemId    String
  employeeId     String
  quantity       Int
  // Snapshot of WorkerStock.unitPrice at request time (for display/value).
  unitPrice      Float             @default(0)
  status         StockRefundStatus @default(PENDING)
  notes          String?           @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("StockRefundRequester", fields: [employeeId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("StockRefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([employeeId])
  @@index([stockItemId])
  @@map("stock_refund_request")
}

model StockLog {
  id                String     @id @default(cuid())
  organizationId    String
  stockItemId       String
  employeeId        String?
  performedById     String
  action            StockAction
  itemName          String
  quantity          Int
  adminQtyBefore    Int?
  adminQtyAfter     Int?
  workerQtyBefore   Int?
  workerQtyAfter    Int?
  notes             String?
  externalBillingId Int?       @map("external_billing_id")
  createdAt         DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  performedBy  User         @relation("StockLogPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, stockItemId])
  @@index([employeeId])
  @@map("stock_log")
}

model Installation {
  id                String    @id @default(cuid())
  organizationId    String
  // Target is exactly one of customerId / stationId (enforced at the API layer)
  customerId        String?
  stationId         String?
  employeeId        String
  stockItemId       String?
  // Set when the install was recorded by closing a field Task (INSTALLATION /
  // REPLACEMENT category). Null for direct worker-portal / prepared installs.
  taskId            String?
  quantity          Int       @default(1)
  price             Float     @default(0)
  isAddOn           Boolean   @default(false)
  status            InstallationStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  notes             String?            @db.Text
  // Set when created by the worker new-customer wizard; the setup-request
  // approval approves the whole bundle atomically.
  setupRequestId    String?
  externalBillingId Int?               @map("external_billing_id")
  installedAt       DateTime           @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  station      Station?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  employee     Employee     @relation("Installer", fields: [employeeId], references: [id], onDelete: Restrict)
  stockItem    StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("InstallationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  setupRequest CustomerSetupRequest? @relation(fields: [setupRequestId], references: [id], onDelete: SetNull)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uninstalledItems UninstalledItem[]

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([stationId])
  @@index([employeeId])
  @@index([setupRequestId])
  @@index([taskId])
  @@map("installation")
}

// ─── Customer Setup Requests (worker-created new customers) ───────

model CustomerSetupRequest {
  id                String             @id @default(cuid())
  organizationId    String
  customerId        String             @unique
  requestedById     String             // Employee (worker) who created the customer
  durationType      String             // "month" | "days"
  durationDays      Int?
  firstChargeAmount Float              // prorated first subscription charge (server-computed)
  status            SetupRequestStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  rejectedReason    String?
  notes             String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedBy   Employee     @relation("SetupRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?        @relation("SetupRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  installations Installation[]

  @@index([organizationId, status])
  @@index([requestedById])
  @@map("customer_setup_request")
}

// ─── Followup ─────────────────────────────────────────────────────

model Followup {
  id                String    @id @default(cuid())
  organizationId    String
  customerId        String?
  customerName      String?
  customerUsername  String?
  mobile            String?
  groupName         String?
  isDone            Boolean   @default(false)
  note              String?   @db.Text
  status            String?   // new | stopped | contacted | etc.
  collectorNote     String?
  externalBillingId Int?      @map("external_billing_id")
  doneAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([customerId])
  @@index([isDone])
  @@map("followup")
}

// ─── Uninstalled Items ────────────────────────────────────────────

model UninstalledItem {
  id                String             @id @default(cuid())
  organizationId    String
  installationId    String?
  taskId            String?
  // Native submissions reference a known stock item; legacy synced rows are name-only.
  stockItemId       String?
  itemName          String
  quantity          Int                @default(1)
  pictureUrl        String?
  employeeId        String?
  status            InstallationStatus @default(PENDING)
  reviewedById      String?
  reviewedAt        DateTime?
  externalBillingId Int?               @map("external_billing_id")
  uninstalledAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  stockItem    StockItem?     @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  reviewedBy   User?          @relation("UninstalledItemReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([taskId])
  @@map("uninstalled_item")
}

model SaltiIntegration {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  apiEndpoint       String    @default("https://saltimarketing.com/")
  encryptedApiToken String    @db.Text
  lastTestedAt      DateTime?
  lastTestStatus    String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("salti_integration")
}

model MarketingBroadcast {
  id              String    @id @default(cuid())
  organizationId  String
  createdById     String
  name            String
  templateName    String
  templateLang    String
  variables       Json
  audienceType    String
  audienceConfig  Json
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  status          String    @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   MarketingBroadcastRecipient[]

  @@index([organizationId, createdAt])
  @@map("marketing_broadcast")
}

model MarketingBroadcastRecipient {
  id             String    @id @default(cuid())
  broadcastId    String
  customerId     String?
  phone          String
  contactName    String?
  variables      Json      @default("{}")
  status         String    @default("queued")
  saltiMessageId String?
  waMessageId    String?
  errorMessage   String?   @db.Text
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  broadcast MarketingBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  customer  Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([broadcastId, status])
  @@index([customerId])
  @@map("marketing_broadcast_recipient")
}
