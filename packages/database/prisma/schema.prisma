  totalNas                Int       @default(0)
  processedNas            Int       @default(0)
  totalRouters            Int       @default(0)
  processedRouters        Int       @default(0)
  totalDealers            Int       @default(0)
  processedDealers        Int       @default(0)
  totalDealerAccounts     Int       @default(0)
  processedDealerAccounts Int       @default(0)
  totalEmployees          Int       @default(0)
  processedEmployees      Int       @default(0)
  totalCustomers          Int       @default(0)
