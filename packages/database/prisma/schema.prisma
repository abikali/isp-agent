  accessPoints  AccessPoint[]
  routers       IspRouter[]
  installations Installation[]

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@map("station")
}

// A Base is a physical/operational hub that can be assigned to one or more
// workers (employees). Dealer-scoped like stations/customers.
model Base {
  id             String   @id @default(cuid())
  organizationId String
  dealerId       String?
  name           String
  description    String?  @db.Text
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealer       IspDealer?     @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  workers      BaseEmployee[]
  tasks        Task[]

  @@index([organizationId])
  @@index([dealerId])
  @@map("base")
}

model BaseEmployee {
  id         String   @id @default(cuid())
  baseId     String
  employeeId String
  assignedAt DateTime @default(now())

  base     Base     @relation(fields: [baseId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([baseId, employeeId])
  @@index([baseId])
  @@index([employeeId])
  @@map("base_employee")
}

model AccessPoint {
  id             String   @id @default(cuid())
  organizationId String
  stationId      String?
  externalId     String?
  name           String
  macAddress     String?
  ipAddress      String?
  signal         String?
  boardName      String?
  version        String?
  interface      String?  // Network interface name
  uptime         String?  // Last known uptime
  isUbiquiti      Boolean  @default(false) // Ubiquiti equipment
  online          Boolean  @default(false)
