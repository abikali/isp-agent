  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, value])
  @@index([organizationId])
  @@map("note_category")
}

enum CashCollectionType {
  HANDOFF
  EXPENSE_DEDUCTION
  STOCK_RECEIVED
  INSTALLATION_COST
  DEALER_PAYMENT
  ADMIN_TRANSFER
  NEW_USER_SETUP
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstallationStatus {
  PENDING
  APPROVED
  COMPLETED
}

enum StockAction {
  ADD
  REMOVE
  TRANSFER_TO_WORKER
  TRANSFER_FROM_WORKER
  ADJUST
  DELIVER
}

// ─── Billing ───────────────────────────────────────────────────────

model BillingMonth {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  month          Int
  locked         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([organizationId, year, month])
  @@index([organizationId])
  @@map("billing_cycle")
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String
  billingMonthId  String        @map("billingCycleId")
  collectorId     String
  accountPrice    Float
  paidAmount      Float
  discount        Float         @default(0)
  status          PaymentStatus @default(COLLECTED)
  freeAccount     Boolean       @default(false)
  stoppedAccount  Boolean       @default(false)
  workerId        String?
  noteCategory    String?
  notes           String?       @db.Text
  receiptSent     Boolean       @default(false)
  receiptSentAt   DateTime?
  paidAt          DateTime      @default(now())
  externalBillingId Int?        @map("external_billing_id")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  billingMonth BillingMonth @relation(fields: [billingMonthId], references: [id], onDelete: Cascade)
  collector    Employee     @relation("PaymentCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  worker       Employee?    @relation("PaymentWorker", fields: [workerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, billingMonthId])
  @@index([workerId])
  @@index([customerId])
  @@index([collectorId])
  @@index([stoppedAccount])
  @@map("payment")
}

model CashCollection {
  id                String             @id @default(cuid())
  organizationId    String
  collectorId       String
  amount            Float
  notes             String?            @db.Text
  type              CashCollectionType @default(HANDOFF)
  expenseId         String?            @unique
  receivedById      String?
  externalBillingId Int?               @map("external_billing_id")
  collectedAt       DateTime           @default(now())
  createdAt         DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collector    Employee     @relation("CashCollector", fields: [collectorId], references: [id], onDelete: Restrict)
  receivedBy   User?        @relation("CashReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  expense      Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, collectorId])
  @@index([collectedAt])
  @@map("cash_collection")
}

model Expense {
  id                String        @id @default(cuid())
  organizationId    String
  submittedById     String
  amount            Float
  description       String        @db.Text
  receiptUrl        String?
  status            ExpenseStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  externalBillingId Int?          @map("external_billing_id")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  Employee        @relation("ExpenseSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  collection   CashCollection?

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, status])
  @@index([submittedById])
  @@map("expense")
}

// ─── Inventory ─────────────────────────────────────────────────────

model StockItem {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  quantity       Int      @default(0)
  costPrice      Float    @default(0)
  sellPrice      Float    @default(0)
  alertThreshold Int?
  alertEnabled   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workerAllocations WorkerStock[]
  logs              StockLog[]
  installations     Installation[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("stock_item")
}

model WorkerStock {
  id          String   @id @default(cuid())
  stockItemId String
  employeeId  String
  quantity    Int      @default(0)
  unitPrice   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockItem StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([stockItemId, employeeId])
  @@index([stockItemId])
  @@index([employeeId])
  @@map("worker_stock")
}

model StockLog {
  id                String     @id @default(cuid())
  organizationId    String
  stockItemId       String
  employeeId        String?
  performedById     String
  action            StockAction
  itemName          String
  quantity          Int
  adminQtyBefore    Int?
  adminQtyAfter     Int?
  workerQtyBefore   Int?
  workerQtyAfter    Int?
  notes             String?
  externalBillingId Int?       @map("external_billing_id")
  createdAt         DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockItem    StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  performedBy  User         @relation("StockLogPerformer", fields: [performedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId, stockItemId])
  @@index([employeeId])
  @@map("stock_log")
}

model Installation {
  id                String    @id @default(cuid())
  organizationId    String
  customerId        String
  employeeId        String
  stockItemId       String?
  quantity          Int       @default(1)
  price             Float     @default(0)
  isAddOn           Boolean   @default(false)
  status            InstallationStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  notes             String?            @db.Text
  externalBillingId Int?               @map("external_billing_id")
  installedAt       DateTime           @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee     Employee     @relation("Installer", fields: [employeeId], references: [id], onDelete: Restrict)
  stockItem    StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  approvedBy   User?        @relation("InstallationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  uninstalledItems UninstalledItem[]

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([customerId])
  @@index([employeeId])
  @@map("installation")
}

// ─── Followup ─────────────────────────────────────────────────────

model Followup {
  id                String    @id @default(cuid())
  organizationId    String
  customerId        String?
  customerName      String?
  customerUsername  String?
  mobile            String?
  groupName         String?
  isDone            Boolean   @default(false)
  note              String?   @db.Text
  status            String?   // new | stopped | contacted | etc.
  collectorNote     String?
  externalBillingId Int?      @map("external_billing_id")
  doneAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([customerId])
  @@index([isDone])
  @@map("followup")
}

// ─── Uninstalled Items ────────────────────────────────────────────

model UninstalledItem {
  id                String             @id @default(cuid())
  organizationId    String
  installationId    String?
  taskId            String?
  itemName          String
  quantity          Int                @default(1)
  pictureUrl        String?
  employeeId        String?
  status            InstallationStatus @default(PENDING)
  externalBillingId Int?               @map("external_billing_id")
  uninstalledAt     DateTime           @default(now())
  createdAt         DateTime           @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation Installation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  task         Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([taskId])
  @@map("uninstalled_item")
}
