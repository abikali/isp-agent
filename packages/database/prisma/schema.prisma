model Customer {
  id                String          @id @default(cuid())
  organizationId    String
  accountNumber     String
  firstName         String?
  lastName          String?
  email             String?
  phone             String?         // iRadius User.Phone (legacy, kept for sync)
  mobile            String?         // Cached primary phone (auto-set from phones array)
  phones            Json            @default("[]") // [{ number: string, primary: boolean }]
  address           String?
  username          String?
  planId            String?
  stationId         String?
  accessPointId     String?
  status            CustomerStatus  @default(ACTIVE)
  connectionType    ConnectionType?
  ipAddress         String?
  macAddress        String?
  monthlyRate       Float?
  balance           Float           @default(0)
  notes             String?         @db.Text
  pin               String?
  pinHash           String?
  externalId        String?
  // Subscription lifecycle
  activatedAt       DateTime?
  expiresAt         DateTime?
  // Network details
  staticIp          String?
  nasHost           String?
  mikrotikUser      String?
  mikrotikInterface String?
  online            Boolean         @default(false)
  // Usage tracking
  downloadBytes      BigInt          @default(0)
  uploadBytes        BigInt          @default(0)
  dailyDownloadBytes BigInt          @default(0)
  dailyUploadBytes   BigInt          @default(0)
  // Stamp from the 15s online + usage sync. Bumped on every tick that includes
  // this externalId in iRadius's snapshot, even when bytes don't change — so
  // the UI can tell "fresh sample" from "frozen value because iRadius dropped
  // this customer from un.Active = 1".
  lastUsageSyncAt    DateTime?
  // Baseline snapshot of downloadBytes/uploadBytes at the start of the current
  // billing cycle (set on activation, re-stamped on renewal when iRadius's
  // ActivatedAccount bumps forward). Monthly usage = downloadBytes - this
  // baseline. Nullable until first activation event is observed.
  cycleStartedAt          DateTime?
  cycleStartDownloadBytes BigInt    @default(0)
  cycleStartUploadBytes   BigInt    @default(0)
  fupMode            String?
  automaticRenew     Boolean         @default(false)
  // Pricing
  discount           Float           @default(0)
  iptvPrice          Float           @default(0)
  realIpPrice        Float           @default(0)
  // Geo
  latitude          Float?
  longitude         Float?
  // Classification
  categoryName      String?
  groupName         String?
  groupExternalId   Int?             // iRadius User.UserGroupId — names aren't unique, FK is needed for mirror writes
  collectorName     String?
  collectorPhone    String?
  // Foreign keys (resolved from iRadius)
  dealerId           String?
  collectorId        String?
  workerId           String?          @map("worker_id")
  nasId              String?
  originalCreatedAt  DateTime?
  // iRadius User fields
  mof                    String?         // Tax registration (MOF)
  lastLogin              DateTime?
  lastLogOut             DateTime?
  autoGenerateInvoice    Boolean         @default(false)
  financialCategoryId    Int?
  linkId                 Int?
  canResetAccount        Boolean         @default(false)
  collectorResetMac      Boolean         @default(false)
  collectorCanShowLinks  Boolean         @default(false)
  readOnly               Boolean         @default(false)
  // iRadius UserNas fields
  nasAccountId                  Int?            // UserNas.Id
  freeDownloadBytes             BigInt          @default(0)
  freeUploadBytes               BigInt          @default(0)
  extraDaysToAddOnRefill        Int?
  extraDaysToDeductOnRefill     Int?
  addedHours                    Int?
  extraUploadGb                 Float?
  extraDownloadGb               Float?
  canShowTrafficDetails         Boolean         @default(false)
  oldAccountTypeId              Int?
  forwardAccountTypeId          Int?
  conditionAccountTypeId        Int?
  deductMoney                   Float?
  reachMaxQuota                 Boolean         @default(false)
  tempUser                      Boolean         @default(false)
  tempExpiryAccount             DateTime?
  mikrotikQueue                 String?
  wirelessInterface             String?
  routerBrandPrefix             String?
  overrideExpiryAccount         DateTime?
  forceExpiryAfterDays          Int?
  forceOverrideImmediateRecharge Boolean       @default(false)
  overrideImmediateRecharge     Boolean         @default(false)
  forceAutoBindAccToMac         Boolean         @default(false)
  overrideAutoBindAccToMac      Boolean         @default(false)
  simultaneous                  Boolean         @default(false)
  apElectrical                  Boolean         @default(false)
  excludeDailyDownloadBytes     BigInt          @default(0)
  excludeDailyUploadBytes       BigInt          @default(0)
  excludeMonthlyDownloadBytes   BigInt          @default(0)
  excludeMonthlyUploadBytes     BigInt          @default(0)
  freeDailyDownloadBytes        BigInt          @default(0)
  freeDailyUploadBytes          BigInt          @default(0)
  excludeFreeDailyDownloadBytes   BigInt        @default(0)
  excludeFreeMonthlyDownloadBytes BigInt        @default(0)
  excludeFreeDailyUploadBytes     BigInt        @default(0)
  excludeFreeMonthlyUploadBytes   BigInt        @default(0)
  nasLastLogOut                 DateTime?
  mikrotikInterface1            String?
  lastSyncedAt      DateTime?
  // Soft-delete marker. Set by the iRadius sync when the corresponding User
  // row (ProfileId=4) is no longer present in iRadius, or when the customer's
  // ParentId moves outside the org's allowed dealer subtree (cross-dealer
  // guard). Cleared on next sync if the row is seen again ("restored").
  // Hard-deleting customers would cascade-wipe payments and installations, so
  // soft-delete is the only safe option here.
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           ServicePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  station        Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  accessPoint    AccessPoint?     @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  dealer         IspDealer?       @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  collector      Employee?        @relation("CustomerCollector", fields: [collectorId], references: [id], onDelete: SetNull)
  worker         Employee?        @relation("CustomerWorker", fields: [workerId], references: [id], onDelete: SetNull)
  nas            IspNas?          @relation(fields: [nasId], references: [id], onDelete: SetNull)

  locationRequestedAt DateTime?

  tasks          Task[]
  conversations  AiConversation[]
  invoices       CustomerInvoice[]
  payments       Payment[]
  referredPayments Payment[] @relation("PaymentReferrer")
  installations  Installation[]
  followups      Followup[]
  setupRequest   CustomerSetupRequest?
  syncConflicts  SyncConflict[]
  locationRequests LocationRequest[]
  marketingMessages MarketingBroadcastRecipient[]

  @@unique([organizationId, accountNumber])
  @@unique([organizationId, externalId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
  @@index([planId])
  @@index([stationId])
  @@index([accessPointId])
  @@index([dealerId])
  @@index([collectorId])
  @@index([workerId])
  @@index([nasId])
  @@index([status])
  @@index([organizationId, lastName, firstName])
  // Accelerates the `hasLocation` filter on the customers list (org-scoped
  // `latitude IS NULL OR longitude IS NULL` / `NOT NULL` predicates).
  @@index([organizationId, latitude, longitude])
  // Accelerates sorting/filtering by "last requested location" for the
  // bulk-request throttle UX.
  @@index([organizationId, locationRequestedAt])
  @@map("customer")
}

model CustomerInvoice {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  year           Int
  month          Int
  invoiceDate    DateTime
  expiryDate     DateTime?
  // Line items — frozen at invoice creation so the receipt is immutable.
  // `total` must equal accountPrice + iptvPrice + realIpPrice - discount
  // when the three line items are set; otherwise `total` is the source of truth.
  accountPrice   Float?
  iptvPrice      Float?
  realIpPrice    Float?
  total          Float     @default(0)
  discount       Float     @default(0)
  tax            Float     @default(0)
  totalWithTax   Float     @default(0)
  note           String?   @db.Text
  // Paid status is NOT stored — it is derived from the linked `payment`
  // relation (paid ⟺ a non-voided Payment exists). Keeping a denormalized
  // boolean drifted (it was never set on payment collection); the Payment
  // row is the single source of truth.
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payment      Payment?

  @@unique([organizationId, customerId, year, month])
  @@index([customerId])
  @@index([organizationId])
  @@index([voidedAt])
  @@map("customer_invoice")
}

model IspNas {
