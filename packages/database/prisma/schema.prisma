  freeDownloadBytes             BigInt          @default(0)
  freeUploadBytes               BigInt          @default(0)
  extraDaysToAddOnRefill        Int?
  extraDaysToDeductOnRefill     Int?
  addedHours                    Int?
  extraUploadGb                 Float?
  extraDownloadGb               Float?
  canShowTrafficDetails         Boolean         @default(false)
  oldAccountTypeId              Int?
  forwardAccountTypeId          Int?
  conditionAccountTypeId        Int?
  deductMoney                   Float?
  reachMaxQuota                 Boolean         @default(false)
  tempUser                      Boolean         @default(false)
  tempExpiryAccount             DateTime?
  mikrotikQueue                 String?
  wirelessInterface             String?
  routerBrandPrefix             String?
  overrideExpiryAccount         DateTime?
  forceExpiryAfterDays          Int?
  forceOverrideImmediateRecharge Boolean       @default(false)
  overrideImmediateRecharge     Boolean         @default(false)
  forceAutoBindAccToMac         Boolean         @default(false)
  overrideAutoBindAccToMac      Boolean         @default(false)
  simultaneous                  Boolean         @default(false)
  apElectrical                  Boolean         @default(false)
  excludeDailyDownloadBytes     BigInt          @default(0)
  excludeDailyUploadBytes       BigInt          @default(0)
  excludeMonthlyDownloadBytes   BigInt          @default(0)
  excludeMonthlyUploadBytes     BigInt          @default(0)
  freeDailyDownloadBytes        BigInt          @default(0)
  freeDailyUploadBytes          BigInt          @default(0)
  excludeFreeDailyDownloadBytes   BigInt        @default(0)
  excludeFreeMonthlyDownloadBytes BigInt        @default(0)
  excludeFreeDailyUploadBytes     BigInt        @default(0)
  excludeFreeMonthlyUploadBytes   BigInt        @default(0)
  nasLastLogOut                 DateTime?
  mikrotikInterface1            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           ServicePlan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  station        Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  accessPoint    AccessPoint?     @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  dealer         IspDealer?       @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  collector      Employee?        @relation("CustomerCollector", fields: [collectorId], references: [id], onDelete: SetNull)
  worker         Employee?        @relation("CustomerWorker", fields: [workerId], references: [id], onDelete: SetNull)
  nas            IspNas?          @relation(fields: [nasId], references: [id], onDelete: SetNull)

  tasks          Task[]
  conversations  AiConversation[]
  transactions   CustomerTransaction[]
  invoices       CustomerInvoice[]
  payments       Payment[]
  installations  Installation[]
  followups      Followup[]

  @@unique([organizationId, accountNumber])
  @@unique([organizationId, externalId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([planId])
  @@index([stationId])
  @@index([accessPointId])
  @@index([dealerId])
  @@index([collectorId])
  @@index([workerId])
  @@index([nasId])
  @@index([status])
  @@index([organizationId, lastName, firstName])
  @@map("customer")
}

