model IspDealer {
  id                   String         @id @default(cuid())
  organizationId       String?
  externalId           String?        @unique
  name                 String
  username             String?
  email                String?
  phone                String?
  companyName          String?
  companyAddress       String?
  companyPhone         String?
  companyMobile        String?
  companyVatNumber     String?
  credit               Float          @default(0)
  commission           Float          @default(0)
  smsSenderId          String?
  notificationAmount   Float?
  fupResetPrice        Float?
  extraOneGbPrice      Float?
  extraOneGbCommission Float?
  canShowRate          Boolean        @default(false)
  canShowSpeed         Boolean        @default(false)
  noCharge             Boolean        @default(false)
  canSendMail          Boolean        @default(false)
  canSendSms           Boolean        @default(false)
  canExportToExcel     Boolean        @default(false)
  canAddDealer         Boolean        @default(false)
  canDeleteUser        Boolean        @default(false)
  canChangeAccountType Boolean        @default(false)
  // iRadius Dealer extra fields
  notifyBefore3Days       Boolean        @default(false)
  notifyBefore2Days       Boolean        @default(false)
  notifyBefore1Day        Boolean        @default(false)
  extraGb                 Boolean        @default(false)
  canShowOnlineUsersSpeed Boolean        @default(false)
  userNotification        Boolean        @default(false)
  canMonitorLog           Boolean        @default(false)
  chargeIfNotExpiry       Boolean        @default(false)
  parentDealerId       String?
  userId               String?        @unique
  status               CustomerStatus @default(ACTIVE)
  lastSyncedAt         DateTime?
  // Soft-delete marker set by the global dealer sync (dealers-only mode) when
  // the corresponding User row (ProfileId=2) is no longer present in iRadius.
  // Hard-delete is avoided because deleting a dealer would cascade-wipe its
  // IspDealerAccount rows (real financial history).
  deletedAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?             @relation("DealerUser", fields: [userId], references: [id], onDelete: SetNull)
  parentDealer   IspDealer?        @relation("DealerHierarchy", fields: [parentDealerId], references: [id], onDelete: SetNull)
