  nasHost           String?
  mikrotikUser      String?
  mikrotikInterface String?
  online            Boolean         @default(false)
  // Usage tracking
  downloadBytes      BigInt          @default(0)
  uploadBytes        BigInt          @default(0)
  dailyDownloadBytes BigInt          @default(0)
  dailyUploadBytes   BigInt          @default(0)
  fupMode            String?
  automaticRenew     Boolean         @default(false)
  // Pricing
  discount           Float           @default(0)
  iptvPrice          Float           @default(0)
  realIpPrice        Float           @default(0)
  // Geo
  latitude          Float?
  longitude         Float?
  // Classification
  categoryName      String?
  groupName         String?
  collectorName     String?
  collectorPhone    String?
  // Foreign keys (resolved from iRadius)
  dealerId           String?
  collectorId        String?
  workerId           String?          @map("worker_id")
  nasId              String?
  originalCreatedAt  DateTime?
  // iRadius User fields
  mof                    String?         // Tax registration (MOF)
  lastLogin              DateTime?
  lastLogOut             DateTime?
  autoGenerateInvoice    Boolean         @default(false)
  financialCategoryId    Int?
  linkId                 Int?
  canResetAccount        Boolean         @default(false)
  collectorResetMac      Boolean         @default(false)
  collectorCanShowLinks  Boolean         @default(false)
  readOnly               Boolean         @default(false)
  // iRadius UserNas fields
