// ============================================================================
// EMPLOYEE & TASK MANAGEMENT MODELS
// ============================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum EmployeeDepartment {
  TECHNICAL
  CUSTOMER_SERVICE
  BILLING
  MANAGEMENT
  FIELD_OPS
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  INSTALLATION
  MAINTENANCE
  REPAIR
  SUPPORT
  BILLING
  GENERAL
  FOLLOW_UP
}

enum TaskSource {
  MANUAL
  AI_ESCALATION
  LEGACY

  @@map("task_source")
}

model Employee {
  id             String             @id @default(cuid())
  organizationId String
  employeeNumber String
  name           String
  email          String?
  phone          String?
  position       String?
  department     EmployeeDepartment?
  hireDate       DateTime?
  status         EmployeeStatus     @default(ACTIVE)
  notes          String?            @db.Text
  externalId     String?
  iRadiusProfile String?
  username        String?
  preferredLayout String            @default("standard") @map("preferred_layout")
  telegramChatId  String?           @map("telegram_chat_id")
  userId          String?           @unique
  dealerId        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User?                 @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  dealer                IspDealer?            @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  stations              EmployeeStation[]
  taskAssignments       TaskAssignment[]
  customerCollections   Customer[]            @relation("CustomerCollector")
  customerWorkerAssignments Customer[]        @relation("CustomerWorker")
  transactionCollections CustomerTransaction[] @relation("TransactionCollector")
  paymentsCollected     Payment[]             @relation("PaymentCollector")
  paymentsAsWorker      Payment[]             @relation("PaymentWorker")
  cashCollections       CashCollection[]      @relation("CashCollector")
  expensesSubmitted     Expense[]             @relation("ExpenseSubmitter")
  workerStock           WorkerStock[]
  stockLogs             StockLog[]
  installationsDone     Installation[]        @relation("Installer")

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, externalId])
  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([dealerId])
  @@index([status])
  @@index([organizationId, name])
  @@map("employee")
}

model EmployeeStation {
  id         String   @id @default(cuid())
  employeeId String
  stationId  String
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  station  Station  @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([employeeId, stationId])
  @@index([employeeId])
  @@index([stationId])
  @@map("employee_station")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?      @db.Text
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  category       TaskCategory @default(GENERAL)
  source         TaskSource   @default(MANUAL)
  dueDate        DateTime?
  completedAt    DateTime?
  notes          String?      @db.Text
  createdById    String?
  customerId     String?
  stationId      String?
  conversationId String?
  followUpStatus String?        // pending | contacted | promised | resolved | escalated
  externalBillingId Int?        @map("external_billing_id")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("taskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  station      Station?         @relation(fields: [stationId], references: [id], onDelete: SetNull)
  conversation AiConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignments  TaskAssignment[]
  uninstalledItems UninstalledItem[]

  @@unique([organizationId, externalBillingId])
  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([customerId])
  @@index([stationId])
  @@index([conversationId])
  @@index([dueDate])
  @@map("task")
}

model TaskAssignment {
  id         String   @id @default(cuid())
  taskId     String
  employeeId String
  assignedAt DateTime @default(now())

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([taskId, employeeId])
  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignment")
}

// ─── Billing Enums ─────────────────────────────────────────────────

enum PaymentStatus {
  COLLECTED
}

model NoteCategory {
  id             String       @id @default(cuid())
  organizationId String
  value          String       // Machine-readable key (e.g. "DOWNGRADE")
  label          String       // Display label (e.g. "Downgrade")
