# Timezone (all date calculations use this)
TZ=Asia/Beirut

# Database
DATABASE_URL="YOUR_DATABASE_CONNECTION_STRING"
# ... if you use Supabase
DIRECT_URL=""

# Site url
VITE_SITE_URL="http://localhost:3000"

# Authentication
BETTER_AUTH_SECRET="A_RANDOM_SECRET_STRING"
# ... for Github
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
# ... for Google
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# AI: API keys are set per agent in the app (AI agent → Model)

# Mails
# ... with nodemailer
MAIL_HOST=""
MAIL_PORT=""
MAIL_USER=""
MAIL_PASS=""
# ... with Plunk
PLUNK_API_KEY=""
# ... with Resend
RESEND_API_KEY=""
# ... with Postmark
POSTMARK_SERVER_TOKEN=""
# ... with Mailgun
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# Payments
# ... with Lemonsqueezy
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_STORE_ID=""
# ... with Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ... with Creem
CREEM_API_KEY=""
CREEM_WEBHOOK_SECRET=""
# ... with Polar
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
# ... with DodoPayments
DODO_PAYMENTS_API_KEY=""

# Product price ids
VITE_PRICE_ID_PRO_MONTHLY="asdf"
VITE_PRICE_ID_PRO_YEARLY="asdf"
VITE_PRICE_ID_LIFETIME="asdf"

# Analytics
# ... for Pirsch
VITE_PIRSCH_CODE=""
# ... for Plausible
VITE_PLAUSIBLE_URL=""
# ... for Mixpanel
VITE_MIXPANEL_TOKEN=""
# ... for Google Analytics
VITE_GOOGLE_ANALYTICS_ID=""

# Error Tracking & Performance Monitoring (Sentry)
SENTRY_DSN=""              # Server-side DSN
VITE_SENTRY_DSN=""         # Client-side DSN (same value as SENTRY_DSN)

# Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, etc.)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"
AVATARS_BUCKET_NAME="avatars"
S3_PUBLIC_URL=""  # Optional: Public URL for serving images directly (e.g., R2 public URL)

# Redis (for job queues, rate limiting, caching)
REDIS_URL="redis://localhost:6383"

# Webhook token signing (generate with: openssl rand -base64 32)
WEBHOOK_SECRET=""

# Integrations (Nango - supports self-hosted)
# For Nango Cloud: Get keys from https://app.nango.dev/environment-settings
# For self-hosted: Get keys from your Nango dashboard
NANGO_SECRET_KEY=""
VITE_NANGO_PUBLIC_KEY=""
# Self-hosted Nango URL (leave empty for Nango Cloud)
NANGO_HOST=""
VITE_NANGO_HOST=""

# Salti / WPBox (WhatsApp Business via saltimarketing.com)
# Powers both the payment-receipt worker and Marketing broadcasts.
# Per-org overrides live in Settings → Marketing; this env is the default.
WPBOX_TOKEN=
# Referral free-month WhatsApp on payment approval (template
# referral_free_month). Leave off until Salti approves the template.
WHATSAPP_REFERRAL_REWARD_ENABLED=false
# Bot follow-up outreach on the official number (install check, day after a
# stop). Nothing is sent while a template name is empty. Set each one once
# Meta approves the template in Salti.
SALTI_TEMPLATE_INSTALL_SATISFACTION=
SALTI_TEMPLATE_SERVICE_STOP_REASON=
# Secret path segment of the inbound webhook set in Salti → WebHooks
# ("Whatsapp received data will be resend to"):
#   https://<host>/api/webhooks/salti/<SALTI_WEBHOOK_SECRET>
SALTI_WEBHOOK_SECRET=
# Optional: only accept forwarded messages for this Meta phone_number_id.
SALTI_PHONE_NUMBER_ID=
# Support-bot (WaSender) number for wa.me deep links in follow-up replies.
SUPPORT_BOT_WHATSAPP_NUMBER=
# Optional override (defaults to https://saltimarketing.com/)
SALTI_API_ENDPOINT=

# Telegram ISP bot ONU lookup (Diagnose "ONU" section + the AI diagnose tool).
# The bot owns the OLT telnet sessions; this is its GET /api/onu-status.
# TG_ISP_ONU_API_KEY must equal the bot's ONU_API_KEY. Unset = "ONU status unavailable".
TG_ISP_BOT_URL=https://tg-isp.abiroot.dev
TG_ISP_ONU_API_KEY=
# GlobeSMS (Lebanese SMS aggregator) — customer payment reminders and stop
# notices, sent from the worker only. Unset = SMS rows fail "SMS not configured".
GLOBESMS_USERNAME=
GLOBESMS_PASSWORD=
# Alphanumeric sender, must be approved by GlobeSMS on the account.
SMS_SENDER_ID=Libancom
# Optional override (defaults to https://globesms.net/smshub/api.php)
GLOBESMS_ENDPOINT=
# Parallel customer-notify sends (GlobeSMS rate limit unknown).
CUSTOMER_NOTIFY_WORKER_CONCURRENCY=3
